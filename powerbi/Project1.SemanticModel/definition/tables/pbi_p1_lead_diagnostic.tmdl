	partition pbi_p1_lead_diagnostic = m
		mode: directQuery
		source =
				let
				    Source = Sql.Database("localhost\SQLEXPRESS", "SEPRO_Master_Prod", [Query="/* ============================================================#(lf)   PROJECT 1 - POWER BI HELPER QUERY#(lf)   Query name in Power BI: pbi_p1_lead_diagnostic#(lf)   Grain: 1 row = 1 lead#(lf)   Purpose: identify WHERE the lead stopped, then explain WHY.#(lf)   ============================================================ */#(lf)SELECT#(lf)    f.lead_id,#(lf)    f.campaign_key,#(lf)    f.customer_key,#(lf)    f.employee_key,#(lf)    f.created_date_key,#(lf)    f.created_at,#(lf)    f.channel,#(lf)    f.lifecycle_status,#(lf)    f.qualified_flag,#(lf)    f.quote_flag,#(lf)    f.order_flag,#(lf)    f.first_response_hours,#(lf)    f.response_bucket,#(lf)    f.net_order_value_vnd,#(lf)    CASE#(lf)        WHEN f.qualified_flag = 0 THEN 'Lead -> Qualified'#(lf)        WHEN f.quote_flag = 0 THEN 'Qualified -> Quote'#(lf)        WHEN f.order_flag = 0 THEN 'Quote -> Order'#(lf)        ELSE 'Converted'#(lf)    END AS funnel_outcome,#(lf)    l.lost_reason,#(lf)    l.budget_status,#(lf)    l.inquiry_type,#(lf)    l.company_size_band,#(lf)    l.purchase_timeline_days,#(lf)    l.product_interest_id,#(lf)    l.expected_value_vnd#(lf)FROM gold.mart_lead_funnel AS f#(lf)LEFT JOIN silver.leads AS l#(lf)    ON l.lead_id = f.lead_id;", HierarchicalNavigation=true])
				in
				    Source

	annotation PBI_ResultType = Table

