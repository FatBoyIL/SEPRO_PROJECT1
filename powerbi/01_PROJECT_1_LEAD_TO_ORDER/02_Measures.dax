// ============================================================
// PROJECT 1 - CALCULATED TABLES
// Create these from Modeling > New table
// ============================================================

p1_funnel_stage =
DATATABLE(
    "Stage", STRING,
    "Sort", INTEGER,
    {
        {"Lead", 1},
        {"Qualified", 2},
        {"Quoted", 3},
        {"Ordered", 4}
    }
)

p1_funnel_transition =
DATATABLE(
    "Transition", STRING,
    "Sort", INTEGER,
    {
        {"Lead -> Qualified", 1},
        {"Qualified -> Quote", 2},
        {"Quote -> Order", 3}
    }
)

// Sort Stage by Sort, and Transition by Sort.

// ============================================================
// FUNNEL MEASURES
// ============================================================

P1 Total Leads =
DISTINCTCOUNT(mart_lead_funnel[lead_id])

P1 Qualified Leads =
CALCULATE(
    [P1 Total Leads],
    mart_lead_funnel[qualified_flag] = TRUE()
)

P1 Quoted Leads =
CALCULATE(
    [P1 Total Leads],
    mart_lead_funnel[quote_flag] = TRUE()
)

P1 Ordered Leads =
CALCULATE(
    [P1 Total Leads],
    mart_lead_funnel[order_flag] = TRUE()
)

P1 Qualified Lead Rate =
DIVIDE([P1 Qualified Leads], [P1 Total Leads])

P1 Lead to Quote Rate =
DIVIDE([P1 Quoted Leads], [P1 Total Leads])

P1 Lead to Order Rate =
DIVIDE([P1 Ordered Leads], [P1 Total Leads])

P1 Net Order Value =
SUM(mart_lead_funnel[net_order_value_vnd])

P1 Order Value per Lead =
DIVIDE([P1 Net Order Value], [P1 Total Leads])

P1 Funnel Stage Count =
SWITCH(
    SELECTEDVALUE(p1_funnel_stage[Stage]),
    "Lead", [P1 Total Leads],
    "Qualified", [P1 Qualified Leads],
    "Quoted", [P1 Quoted Leads],
    "Ordered", [P1 Ordered Leads]
)

P1 Funnel Stage Rate =
DIVIDE([P1 Funnel Stage Count], [P1 Total Leads])

P1 Dropoff Count =
SWITCH(
    SELECTEDVALUE(p1_funnel_transition[Transition]),
    "Lead -> Qualified", [P1 Total Leads] - [P1 Qualified Leads],
    "Qualified -> Quote", [P1 Qualified Leads] - [P1 Quoted Leads],
    "Quote -> Order", [P1 Quoted Leads] - [P1 Ordered Leads]
)

P1 Dropoff Rate =
SWITCH(
    SELECTEDVALUE(p1_funnel_transition[Transition]),
    "Lead -> Qualified", DIVIDE([P1 Total Leads] - [P1 Qualified Leads], [P1 Total Leads]),
    "Qualified -> Quote", DIVIDE([P1 Qualified Leads] - [P1 Quoted Leads], [P1 Qualified Leads]),
    "Quote -> Order", DIVIDE([P1 Quoted Leads] - [P1 Ordered Leads], [P1 Quoted Leads])
)

// ============================================================
// RESPONSE TIME
// ============================================================
// Create as a calculated column in mart_lead_funnel, then sort
// response_bucket by this column.
P1 Response Bucket Sort =
SWITCH(
    mart_lead_funnel[response_bucket],
    "Invalid Negative", 0,
    "< 4h", 1,
    "4-12h", 2,
    "12-24h", 3,
    "> 24h", 4,
    "No Sales Activity", 5,
    99
)


P1 Leads with Sales Activity =
CALCULATE(
    [P1 Total Leads],
    NOT ISBLANK(mart_lead_funnel[first_response_hours])
)

P1 No Sales Activity Leads =
[P1 Total Leads] - [P1 Leads with Sales Activity]

P1 No Sales Activity Rate =
DIVIDE([P1 No Sales Activity Leads], [P1 Total Leads])

P1 Median First Response Hours =
MEDIANX(
    FILTER(
        mart_lead_funnel,
        NOT ISBLANK(mart_lead_funnel[first_response_hours])
    ),
    mart_lead_funnel[first_response_hours]
)

P1 P25 First Response Hours =
PERCENTILEX.INC(
    FILTER(mart_lead_funnel, NOT ISBLANK(mart_lead_funnel[first_response_hours])),
    mart_lead_funnel[first_response_hours],
    0.25
)

P1 P75 First Response Hours =
PERCENTILEX.INC(
    FILTER(mart_lead_funnel, NOT ISBLANK(mart_lead_funnel[first_response_hours])),
    mart_lead_funnel[first_response_hours],
    0.75
)

P1 P90 First Response Hours =
PERCENTILEX.INC(
    FILTER(mart_lead_funnel, NOT ISBLANK(mart_lead_funnel[first_response_hours])),
    mart_lead_funnel[first_response_hours],
    0.90
)

P1 IQR Response Hours =
[P1 P75 First Response Hours] - [P1 P25 First Response Hours]

P1 Response IQR Upper Bound =
[P1 P75 First Response Hours] + 1.5 * [P1 IQR Response Hours]

P1 Response Outlier Leads =
VAR UpperBound = [P1 Response IQR Upper Bound]
RETURN
CALCULATE(
    [P1 Total Leads],
    FILTER(
        mart_lead_funnel,
        NOT ISBLANK(mart_lead_funnel[first_response_hours]) &&
        mart_lead_funnel[first_response_hours] > UpperBound
    )
)

// ============================================================
// CHANNEL QUALITY - use mart_channel_quality so spend is not
// duplicated at lead grain.
// ============================================================

P1 Marketing Spend =
SUM(mart_channel_quality[marketing_spend_vnd])

P1 CQ Leads =
SUM(mart_channel_quality[total_leads])

P1 CQ Qualified Leads =
SUM(mart_channel_quality[qualified_leads])

P1 CQ Quoted Leads =
SUM(mart_channel_quality[quoted_leads])

P1 CQ Ordered Leads =
SUM(mart_channel_quality[ordered_leads])

P1 CQ Net Order Value =
SUM(mart_channel_quality[net_order_value_vnd])

P1 CPL =
DIVIDE([P1 Marketing Spend], [P1 CQ Leads])

P1 Channel Qualified Rate =
DIVIDE([P1 CQ Qualified Leads], [P1 CQ Leads])

P1 Channel Lead to Quote Rate =
DIVIDE([P1 CQ Quoted Leads], [P1 CQ Leads])

P1 Channel Lead to Order Rate =
DIVIDE([P1 CQ Ordered Leads], [P1 CQ Leads])

P1 Channel Order Value per Lead =
DIVIDE([P1 CQ Net Order Value], [P1 CQ Leads])

// ============================================================
// DIAGNOSTIC
// ============================================================

P1 Diagnostic Leads =
DISTINCTCOUNT(pbi_p1_lead_diagnostic[lead_id])

P1 Lost Diagnostic Leads =
CALCULATE(
    [P1 Diagnostic Leads],
    pbi_p1_lead_diagnostic[funnel_outcome] <> "Converted"
)
